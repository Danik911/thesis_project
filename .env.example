# ==========================================
# LLM API Keys (REQUIRED)
# ==========================================

# OpenRouter API Key (for DeepSeek V3 - PRODUCTION)
# Sign up: https://openrouter.ai/keys
# Format: sk-or-v1-...
# Used for: LLM generation (DeepSeek V3 - $1.35 per 1M tokens)
OPENAI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM Provider Selection
# Options: openrouter (production), openai (testing only)
LLM_PROVIDER=openrouter

# ==========================================
# Optional API Keys (for specific agents)
# ==========================================
CO_API_KEY="your-co-api-key"
QDRANT_API_KEY="your-qdrant-api-key"
QDRANT_URL="your-qdrant-url"
TAVILY_API_KEY="your-tavily-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GITHUB_TOKEN="your-github-token"
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_CLOUD_PROJECT="your-google-cloud-project"
BRAVE_API_KEY="your-brave-api-key"
PERPLEXITY_API_KEY="your-perplexity-api-key"
PPLX_API_KEY="your-pplx-api-key"
ONE_SEARCH_API_KEY="your-one-search-api-key"

# ==========================================
# LangFuse Cloud Observability (Production)
# ==========================================
# Sign up: https://cloud.langfuse.com
# Region: EU (GDPR compliant)
# Automatic trace capture via @observe decorators

# Public API Key
# Location: LangFuse Dashboard → Settings → API Keys → Public Key
# Format: pk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret API Key
# Location: LangFuse Dashboard → Settings → API Keys → Secret Key
# Format: sk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LangFuse Host (EU by default, US available)
# EU: https://cloud.langfuse.com (default)
# US: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# ==========================================
# Model Configuration (PRODUCTION)
# ==========================================

# LLM Model for Test Generation
# Production: deepseek/deepseek-chat (DeepSeek V3 - 671B MoE)
# Cost: $1.35 per 1M tokens (91% reduction from GPT-4)
# Testing: gpt-4o-mini (for rapid prototyping)
LLM_MODEL=deepseek/deepseek-chat

# Embedding Model (OpenAI)
# Used for: ChromaDB document embeddings and RAG retrieval
# CRITICAL: Must be consistent across all components
EMBEDDING_MODEL=text-embedding-3-small

# Timeouts (in seconds)
WORKFLOW_TIMEOUT=1800
LLM_TIMEOUT=600
LLM_MAX_RETRIES=5
OPENAI_TIMEOUT=600

# ==========================================
# Cost Control (Task 4.5)
# ==========================================
# Daily Job Limit - Maximum jobs allowed per day (globally)
# Used for cost control in staging/development environments
# Set to 0 to disable limit
# Jobs reset at midnight UTC
DAILY_JOB_LIMIT=10

# ==========================================
# Frontend Configuration (Next.js Dashboard)
# ==========================================

# API Base URL (for frontend to connect to backend)
# Development: http://localhost:8080
# Production: https://api.your-domain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Clerk Publishable Key (Frontend)
# Location: Clerk Dashboard → API Keys → Publishable Key
# Format: pk_test_... (development) or pk_live_... (production)
# Used for: Frontend authentication UI
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# RAG Configuration
RAG_ONLY_MODE=true
RAG_CONFIDENCE_THRESHOLD=0.7
RAG_ENABLE_QUERY_EXPANSION=true
RAG_MAX_CHUNKS_PER_QUERY=10

# Document Processing
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=200
RAG_MAX_DOCUMENT_PAGES=30
RAG_SUPPORTED_FORMATS=pdf,md,txt

# Vector Database
# Default: ./chroma_db (resolves to /app/chroma_db in Docker, matches volume mount)
RAG_VECTOR_STORE_PATH=/app/chroma_db
RAG_ENABLE_METADATA_FILTERING=true
RAG_CACHE_EMBEDDINGS=true
RAG_CACHE_DIR=./cache/rag

# Performance
RAG_QUERY_TIMEOUT=5000
RAG_BATCH_SIZE=50
RAG_ENABLE_PARALLEL_PROCESSING=true

# Advanced Features
RAG_ENABLE_GRAPHRAG=false
RAG_ENABLE_HYBRID_SEARCH=true

# ==========================================
# AWS Production Configuration (Task 4.2)
# ==========================================
# These variables are set automatically by ECS task definition
# Only needed for local testing with production S3 data

# S3 ChromaDB Storage (Production)
# Bucket created by Terraform: pharma-test-gen-chromadb-{account_id}
# S3_CHROMADB_BUCKET=pharma-test-gen-chromadb-123456789012
# S3_CHROMADB_KEY=chroma_db.tar.gz

# Environment Detection
# production: Downloads ChromaDB from S3 on startup
# development: Uses local ChromaDB at RAG_VECTOR_STORE_PATH
# ENVIRONMENT=production

# AWS Region for S3 access
# AWS_REGION=eu-west-2

# RAG Extractor Model Configuration (Phase 1 Cost Optimization)
RAG_EXTRACTOR_MODEL=gpt-4.1-nano-2025-04-14
RAG_EXTRACTOR_TEMPERATURE=0.1
RAG_EXTRACTOR_MAX_TOKENS=500

# Project Specific
ENGINEER_NAME="Your Name"

# ==========================================
# Clerk Authentication Configuration (Task 1.4)
# ==========================================
# REQUIRED for FastAPI authentication with Clerk JWT tokens

# Backend API Secret Key
# Location: Clerk Dashboard → API Keys → Secret Key
# Format: sk_test_... (development) or sk_live_... (production)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PEM Public Key for JWT Verification
# Location: Clerk Dashboard → API Keys → Show JWT public key → PEM Public Key
# Format: Multi-line PEM key including headers/footers
# IMPORTANT: Replace literal \n with actual newlines in your .env file
CLERK_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
-----END PUBLIC KEY-----"

# JWT Issuer URL
# Location: Clerk Dashboard → Home → Frontend API URL
# Format: https://your-instance.clerk.accounts.dev (development)
#         https://your-custom-domain.com (production with custom domain)
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# JWT Audience (OPTIONAL - DISABLED FOR SESSION TOKENS)
# Location: Clerk Dashboard → JWT Templates → Default → Audience
# **IMPORTANT:** Session tokens don't include 'aud' claim - leave commented out!
# Only uncomment if using Client API tokens (not session tokens)
# Example: https://api.example.com
# CLERK_JWT_AUDIENCE=https://api.example.com

# Clerk Server URL (OPTIONAL)
# Required ONLY for EU data residency compliance
# US (default): https://api.clerk.com/v1
# EU: https://eu-api.clerk.com/v1
# CLERK_SERVER_URL=https://eu-api.clerk.com/v1

# ==========================================
# Clerk Configuration Notes
# ==========================================

# 1. Clock Skew Tolerance: JWT verification allows 10 seconds clock skew
# 2. Token Expiration: Clerk session tokens expire after 60 SECONDS! (not 1 hour)
#    - Generate fresh tokens immediately before testing
#    - Use main/scripts/create_clerk_session.py for testing
# 3. Session Token Claims: 'aud' and 'email' claims may be missing
#    - Audience verification disabled in dependencies.py
#    - Email claim is optional in ClerkClaims model
# 4. Environment Variables: Must restart server after .env changes
#    - Server reload NOT sufficient for environment variable changes
#    - Use python-dotenv loading in main/api/app.py
# 5. EU Endpoints: If using EU data residency, configure both CLERK_SERVER_URL
#    and ensure your Clerk instance is in EU region
# 6. Test Mode: Clerk development instances support up to 100 test users
#    without domain verification

# ==========================================
# GAMP-5 Compliance Notes
# ==========================================

# - CLERK_ISSUER must match JWT 'iss' claim exactly
# - All authentication events logged to audit trail
# - User attribution captured via 'sub' claim (Clerk user ID)
# - Email captured for human-readable audit logs (ALCOA+)
# - Token lifecycle tracked via 'iat' and 'exp' claims
# - No fallback logic: Authentication failures = 401 errors