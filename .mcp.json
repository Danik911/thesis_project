				"-y",
				"one-search-mcp"
			],
			"env": {
				"SEARCH_PROVIDER": "tavily",
				"SEARCH_API_KEY": "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",
				"FIRECRAWL_API_KEY": "fc-c6514ba933e64dc9aa10be5f786a84df",
