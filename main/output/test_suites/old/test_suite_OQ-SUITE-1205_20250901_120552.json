    {
      "test_id": "OQ-001",
      "test_name": "Legacy Data Migration Checksum Verification",
      "test_category": "data_integrity",
      "gamp_category": 3,
      "objective": "Verify that the checksum of migrated data matches the original data to ensure data integrity during migration.",
      "prerequisites": [
        "Legacy data extraction completed",
        "Migration tooling configured"
      ],
      "test_steps": [
        {
          "step_number": 1,
          "action": "Extract checksum values from the legacy mainframe system.",
          "expected_result": "Checksum values are successfully extracted and recorded.",
          "data_to_capture": [
            "Legacy checksum values"
          ],
          "verification_method": "visual_inspection",
          "acceptance_criteria": "Result matches expected outcome",
          "performed_by": "QA Technician",
          "timestamp_required": true
        },
        {
          "step_number": 2,
          "action": "Calculate checksum values for the migrated data in the cloud platform.",
          "expected_result": "Checksum values are successfully calculated and recorded.",
          "data_to_capture": [
            "Migrated checksum values"
          ],
          "verification_method": "visual_inspection",
          "acceptance_criteria": "Result matches expected outcome",
          "performed_by": "QA Technician",
          "timestamp_required": true
        },
        {
          "step_number": 3,
          "action": "Compare the checksum values from the legacy and migrated data.",
          "expected_result": "Checksum values match, confirming data integrity.",
          "data_to_capture": [
            "Comparison results"
          ],
          "verification_method": "visual_inspection",
          "acceptance_criteria": "Result matches expected outcome",
          "performed_by": "QA Technician",
          "timestamp_required": true
        }
      ],
      "acceptance_criteria": [
        "Checksum values match between legacy and migrated data."
      ],
      "regulatory_basis": [
        "21 CFR Part 11"
      ],
      "risk_level": "high",
      "data_integrity_requirements": [
        "Ensure ALCOA+ attributes are maintained"
      ],
      "urs_requirements": [
        "URS-030-001",
        "URS-030-008"
      ],
      "related_tests": [
        "OQ-002"
      ],
      "estimated_duration_minutes": 30,
      "required_expertise": [
        "Data migration",
        "Checksum verification"
      ],
      "reviewed_by": "QA Manager",
      "data_retention_period": "10 years",
      "execution_timestamp_required": true
    },
