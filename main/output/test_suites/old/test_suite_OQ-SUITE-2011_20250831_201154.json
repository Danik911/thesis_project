    {
      "test_id": "OQ-001",
      "test_name": "Legacy Data Migration Checksum Verification",
      "test_category": "data_integrity",
      "gamp_category": 3,
      "objective": "Verify that checksums of extracted legacy data match the transformed and loaded data in the cloud platform.",
      "prerequisites": [
        "Legacy system data extraction completed",
        "Cloud platform staging environment ready",
        "Checksum generation tool installed"
      ],
      "test_steps": [
        {
          "step_number": 1,
          "action": "Generate checksums for all legacy data files before extraction.",
          "expected_result": "Checksums are successfully generated and documented.",
          "data_to_capture": [
            "Checksum values",
            "File names",
            "Timestamp"
          ],
          "verification_method": "visual_inspection",
          "acceptance_criteria": "Result matches expected outcome",
          "performed_by": "QA Technician",
          "timestamp_required": true
        },
        {
          "step_number": 2,
          "action": "Extract data from the legacy system and store in staging area.",
          "expected_result": "Data is extracted without errors and stored in staging.",
          "data_to_capture": [
            "Extraction logs",
            "Error reports"
          ],
          "verification_method": "visual_inspection",
          "acceptance_criteria": "Result matches expected outcome",
          "performed_by": "QA Technician",
          "timestamp_required": true
        },
        {
          "step_number": 3,
          "action": "Generate checksums for the transformed data before loading to cloud.",
          "expected_result": "Checksums match the original legacy data checksums.",
          "data_to_capture": [
            "Checksum values",
            "Transformation logs"
          ],
          "verification_method": "visual_inspection",
          "acceptance_criteria": "Result matches expected outcome",
          "performed_by": "QA Technician",
          "timestamp_required": true
        }
      ],
      "acceptance_criteria": [
        "All checksums match between legacy and transformed data.",
        "No data corruption detected during migration."
      ],
      "regulatory_basis": [
        "21 CFR Part 11",
        "ALCOA+ principles"
      ],
      "risk_level": "critical",
      "data_integrity_requirements": [
        "Data must remain unchanged during migration.",
        "Checksums must be verifiable at each stage."
      ],
      "urs_requirements": [
        "URS-030-001",
        "URS-030-008"
      ],
      "related_tests": [
        "OQ-002"
      ],
      "estimated_duration_minutes": 60,
