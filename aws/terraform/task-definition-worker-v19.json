{
    "family": "pharma-test-gen-worker",
    "containerDefinitions": [
        {
            "name": "worker",
            "image": "275333454012.dkr.ecr.eu-west-2.amazonaws.com/pharma-test-gen-worker:staging-diagnostic-v1",
            "cpu": 2048,
            "memory": 4096,
            "portMappings": [],
            "essential": true,
            "environment": [
                {
                    "name": "LANGFUSE_HOST",
                    "value": "https://cloud.langfuse.com"
                },
                {
                    "name": "AWS_REGION",
                    "value": "eu-west-2"
                },
                {
                    "name": "SQS_QUEUE_URL",
                    "value": "https://sqs.eu-west-2.amazonaws.com/275333454012/pharma-test-gen-worker-jobs"
                },
                {
                    "name": "S3_CHROMADB_BUCKET",
                    "value": "pharma-test-gen-chromadb-275333454012"
                },
                {
                    "name": "DATABASE_NAME",
                    "value": "pharma_test_gen"
                },
                {
                    "name": "ENVIRONMENT",
                    "value": "staging"
                },
                {
                    "name": "OUTPUT_BUCKET",
                    "value": "pharma-test-gen-output-staging"
                },
                {
                    "name": "RAG_VECTOR_STORE_PATH",
                    "value": "/app/chroma_db"
                },
                {
                    "name": "LLM_PROVIDER",
                    "value": "openrouter"
                },
                {
                    "name": "S3_CHROMADB_KEY",
                    "value": "chroma_db.tar.gz"
                },
                {
                    "name": "LLM_MODEL",
                    "value": "deepseek/deepseek-chat"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "linuxParameters": {
                "initProcessEnabled": true
            },
            "secrets": [
                {
                    "name": "DATABASE_URL",
                    "valueFrom": "arn:aws:secretsmanager:eu-west-2:275333454012:secret:pharma-test-gen/database-url-dDBDUm"
                },
                {
                    "name": "OPENAI_API_KEY",
                    "valueFrom": "arn:aws:secretsmanager:eu-west-2:275333454012:secret:pharma-test-gen/openrouter-9BAg9h:OPENAI_API_KEY::"
                },
                {
                    "name": "OPENROUTER_API_KEY",
                    "valueFrom": "arn:aws:secretsmanager:eu-west-2:275333454012:secret:pharma-test-gen/openrouter-9BAg9h:OPENROUTER_API_KEY::"
                },
                {
                    "name": "LANGFUSE_PUBLIC_KEY",
                    "valueFrom": "arn:aws:secretsmanager:eu-west-2:275333454012:secret:pharma-test-gen/langfuse-5TMVwo:LANGFUSE_PUBLIC_KEY::"
                },
                {
                    "name": "LANGFUSE_SECRET_KEY",
                    "valueFrom": "arn:aws:secretsmanager:eu-west-2:275333454012:secret:pharma-test-gen/langfuse-5TMVwo:LANGFUSE_SECRET_KEY::"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/pharma-test-gen/worker",
                    "awslogs-region": "eu-west-2",
                    "awslogs-stream-prefix": "worker"
                }
            },
            "systemControls": []
        }
    ],
    "cpu": "2048",
    "memory": "4096",
    "networkMode": "awsvpc",
    "taskRoleArn": "arn:aws:iam::275333454012:role/pharma-test-gen-worker-task-role",
    "executionRoleArn": "arn:aws:iam::275333454012:role/pharma-test-gen-ecs-task-execution-role",
    "requiresCompatibilities": [
        "FARGATE"
    ]
}
