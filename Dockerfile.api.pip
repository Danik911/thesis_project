#
# Multi-stage Docker build for FastAPI pharmaceutical test generation API
# PIP variant for cross-platform builds (QEMU-compatible)
#
# GAMP-5 Compliance:
# - Reproducible builds via pinned versions
# - Non-root user execution for security
# - Tini init system for graceful shutdown (ALCOA+ data integrity)
# - Healthcheck for system monitoring (audit trail)
#
# Target: AWS ECS Fargate (linux/amd64)
#

# =============================================================================
# Stage 1: Builder - Install dependencies and compile native extensions
# =============================================================================
FROM python:3.12-slim-bookworm AS builder

WORKDIR /app

# Install build dependencies for compiling native extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy requirements and install dependencies
COPY requirements-prod.txt ./
RUN pip install --no-cache-dir -r requirements-prod.txt

# Copy application code
COPY main/ ./main/
COPY README.md ./
COPY pyproject.toml ./

# Install the project itself
RUN pip install --no-cache-dir -e . --no-deps

# =============================================================================
# Stage 2: Runtime - Minimal production image
# =============================================================================
FROM python:3.12-slim-bookworm

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    tini \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security (GAMP-5 access control)
RUN useradd -m -u 1000 appuser && \
    chown appuser:appuser /app

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code
COPY --from=builder --chown=appuser:appuser /app/main ./main
COPY --from=builder --chown=appuser:appuser /app/README.md ./

# Switch to non-root user
USER appuser

# Environment variables for production
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ENVIRONMENT=production

# Expose API port
EXPOSE 8080

# Use tini as init system for proper signal handling
ENTRYPOINT ["/usr/bin/tini", "--"]

# Healthcheck for ECS/ALB health monitoring
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run FastAPI with uvicorn
CMD ["python", "-m", "uvicorn", "main.api.app:app", "--host", "0.0.0.0", "--port", "8080"]
