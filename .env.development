# =============================================================================
# Docker Compose Development Environment Configuration
# =============================================================================
#
# This file is loaded by docker-compose.dev.yml for local development.
#
# CRITICAL SECURITY REQUIREMENTS:
# - DO NOT commit this file to Git (.gitignore enforced)
# - DO NOT use production credentials (use test/dev instances only)
# - DO NOT load regulated data (synthetic test data only)
#
# GAMP-5 Category 5: Custom software development environment
# ALCOA+ Principles: Relaxed for development (no regulated data)
#
# Parity with AWS Production:
# - Aurora Data API → Local Postgres (binary protocol, lower latency)
# - AWS SQS → LocalStack SQS (some features missing: FIFO guarantees, deduplication)
# - S3 → Local filesystem (no Object Lock immutability)
#
# =============================================================================

# -----------------------------------------------------------------------------
# Application Mode
# -----------------------------------------------------------------------------
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Storage Adapter Configuration
# -----------------------------------------------------------------------------
# Mode: local (filesystem) or s3 (AWS S3)
# Development default: local (no AWS credentials needed)
STORAGE_MODE=local
STORAGE_LOCAL_BASE_PATH=/app/output

# For S3 mode testing with LocalStack (requires SERVICES=s3,sqs in docker-compose):
# STORAGE_MODE=s3
# STORAGE_TEST_OUTPUT_BUCKET=local-test-bucket
# STORAGE_AWS_REGION=eu-west-2

# -----------------------------------------------------------------------------
# Vector Store Configuration
# -----------------------------------------------------------------------------
# Mode: chromadb (in-memory/persistent) or pgvector (PostgreSQL)
# Development default: chromadb (faster, simpler)
RAG_MODE=chromadb
CHROMA_PATH=/app/chroma_db
CHROMA_COLLECTION=pharma_docs

# For pgvector testing (parity with Aurora + pgvector in production):
# RAG_MODE=pgvector
# VECTOR_STORE_CONNECTION_STRING=postgresql://postgres:devpassword@postgres:5432/testgen
# VECTOR_STORE_TABLE=rag_documents
# EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# Queue Configuration
# -----------------------------------------------------------------------------
# Mode: sqs (LocalStack) or memory (pure in-memory asyncio.Queue)
# Development default: sqs (production parity)
QUEUE_MODE=sqs

# LocalStack SQS Configuration
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://localstack:4566/000000000000/testgen-jobs

# For pure in-memory testing (no LocalStack):
# QUEUE_MODE=memory

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# Mock Aurora Data API with local Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=testgen
DATABASE_URL=postgresql://postgres:devpassword@postgres:5432/testgen

# -----------------------------------------------------------------------------
# Clerk Authentication (Development Instance)
# -----------------------------------------------------------------------------
# SECURITY: Use test/dev instance only (NOT production)
# Get keys from: https://dashboard.clerk.com/apps/your-app-id/instances
#
# Required for JWT verification in FastAPI backend
CLERK_ISSUER=https://helped-sturgeon-19.clerk.accounts.dev
CLERK_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAzRHba6EbVdh7cRyyiTE6
bFCcwig6EmfnQiFHr1h8AjBvhJIfM/tc6YG/Tjg8xv0VgEMN4ZGLAta7wCJDmB/h
Kxj/j7dsNN7cVg2qCoF2bZD3/jRMEzhbdiJm2HaSZwJ6LjFgm9bmsX0WHWWUuRHY
ErNEQesT9A30QVcRGr1GadB3otwXl5dNI408qurjw2CV4c9UroxixM5Yxgt5LIxC
drXAzI7/tktvJbaze31wD0DWCLMpxYu1OFnUEd6rIvEtzSFNU/87kRi5w3drjIyW
FMg+CyGu6ARwIwcETzEOnp1UfmcibXkUTbCztRwcWE58kibZnmJ/3X8MXPgJyBDc
FQIDAQAB
-----END PUBLIC KEY-----"

# Optional: Audience claim (session tokens may not include 'aud')
# CLERK_JWT_AUDIENCE=https://helped-sturgeon-19.clerk.accounts.dev

# -----------------------------------------------------------------------------
# LangFuse Observability (Optional - Cloud Instance)
# -----------------------------------------------------------------------------
# Get keys from: https://cloud.langfuse.com (EU region)
# Sign up for free account and create a project to get these keys
LANGFUSE_PUBLIC_KEY=REPLACE_WITH_YOUR_PUBLIC_KEY
LANGFUSE_SECRET_KEY=REPLACE_WITH_YOUR_SECRET_KEY
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# For local LangFuse instance (self-hosted):
# LANGFUSE_BASE_URL=http://langfuse:3000

# -----------------------------------------------------------------------------
# OpenRouter API (DeepSeek V3)
# -----------------------------------------------------------------------------
# CRITICAL: MUST use DeepSeek V3 for pharmaceutical workflow
# FORBIDDEN: GPT-4, O3, O1, Claude, or any OpenAI generation models
#
# Get API key from: https://openrouter.ai/keys
# Model: deepseek/deepseek-chat (671B MoE)
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_API_KEY
LLM_MODEL=deepseek/deepseek-chat

# Embedding Model (OpenAI API - embeddings only, NOT generation)
# Model: text-embedding-3-small (1536 dimensions)
EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# LocalStack Configuration
# -----------------------------------------------------------------------------
# Internal service name for Docker Compose networking
LOCALSTACK_HOST=localstack

# Enable debug logging (development only)
DEBUG=1

# -----------------------------------------------------------------------------
# Development-Specific Settings
# -----------------------------------------------------------------------------
# Python logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

# Disable bytecode caching (code changes require container restart otherwise)
PYTHONDONTWRITEBYTECODE=1

# Unbuffered stdout/stderr (faster log visibility)
PYTHONUNBUFFERED=1

# Disable uvicorn reload watcher by default to avoid watchfiles OOM in WSL2
# Set to 1 only when you need live reload and have adequate memory (~4GB)
UVICORN_RELOAD=0

# =============================================================================
# Usage Instructions
# =============================================================================
#
# 1. Copy this file and replace placeholder values:
#    - OPENAI_API_KEY: Your OpenRouter API key
#    - Optionally update Clerk keys if using different dev instance
#
# 2. Start services:
#    docker-compose -f docker-compose.dev.yml up -d
#
# 3. View logs:
#    docker-compose -f docker-compose.dev.yml logs -f
#
# 4. Test API:
#    curl http://localhost:8080/health
#
# 5. Stop services:
#    docker-compose -f docker-compose.dev.yml down
#
# 6. Reset data (delete volumes):
#    docker-compose -f docker-compose.dev.yml down --volumes
#
# =============================================================================
