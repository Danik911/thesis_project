# =============================================================================
# MES Agentic BI - Environment Variables
# =============================================================================
# Copy to .env.local and fill in values

# --- LLM Copilot ---
OPENROUTER_API_KEY=sk-or-v1-...
BI_COPILOT_MODEL=anthropic/claude-sonnet-4-20250514
BI_COPILOT_TEMPERATURE=0.2
BI_MAX_UPLOAD_SIZE_MB=50

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- ALCOA+ Audit Trail ---
BI_AUDIT_ENABLED=true
BI_AUDIT_LOG_GROUP=/mes-agentic-bi/audit
BI_AUDIT_LOG_STREAM_PREFIX=bi-audit
BI_AUDIT_AWS_REGION=eu-west-2

# --- CloudTrail Lake (deferred) ---
BI_CLOUDTRAIL_LAKE_ENABLED=false
BI_CLOUDTRAIL_LAKE_CHANNEL_ARN=
BI_CLOUDTRAIL_LAKE_REGION=eu-west-2

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Voice (optional) ---
BI_VOICE_ENABLED=false
BI_VOICE_TTS_ENABLED=false
BI_VOICE_POLLY_REGION=eu-west-2
BI_VOICE_POLLY_VOICE_ID=Amy

# --- Snowflake (optional) ---
# Credentials are provided per-request via the UI, not env vars

# --- Cognito RBAC (optional — disabled by default) ---
BI_AUTH_ENABLED=false
BI_COGNITO_REGION=eu-west-1
BI_COGNITO_USER_POOL_ID=
BI_COGNITO_CLIENT_ID=
BI_SITE_COLUMN_NAME=Site
BI_CORS_ORIGINS=*

# Frontend auth (must match backend Cognito settings)
NEXT_PUBLIC_BI_AUTH_ENABLED=false
NEXT_PUBLIC_BI_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_BI_COGNITO_CLIENT_ID=
NEXT_PUBLIC_BI_COGNITO_REGION=eu-west-1
