
#
# Multi-stage Docker build for background job worker
#
# GAMP-5 Compliance:
# - Reproducible builds via pinned versions
# - Non-root user execution for security
# - Tini init system for graceful shutdown (ALCOA+ data integrity)
# - No healthcheck (workers don't expose HTTP endpoints)
#
# Target: AWS ECS Fargate (linux/amd64)
# Size Target: <200MB
#

# =============================================================================
# Stage 1: Builder - Install dependencies and compile native extensions
# =============================================================================
FROM python:3.12-slim-bookworm AS builder

WORKDIR /app

# Install build dependencies for compiling native extensions
# - gcc: C compiler for psycopg2, cryptography, etc.
# - libpq-dev: PostgreSQL development headers (for psycopg2 compilation)
# - curl: For downloading uv package manager
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc=4:12.2.* \
    libpq-dev=15.* \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv package manager (pinned version for reproducibility)
# Using direct download instead of ghcr.io to avoid DNS resolution issues in WSL2
RUN curl -LsSf https://astral.sh/uv/0.9.8/install.sh | UV_INSTALL_DIR=/usr/local/bin sh

# Configure uv for Docker environment
# UV_COMPILE_BYTECODE=1: Pre-compile .pyc files for faster startup (~20% improvement)
# UV_LINK_MODE=copy: Required for Docker (hard links not supported in multi-stage)
# UV_PYTHON_DOWNLOADS=never: Use system Python from base image
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

# Copy dependency files FIRST (maximize cache hit rate)
# These change less frequently than application code
COPY pyproject.toml uv.lock ./

# Install dependencies with cache mount
# --frozen: Fail if uv.lock out of sync (ensures reproducibility)
# --no-install-project: Skip installing the project itself (just dependencies)
# --no-dev: Exclude development dependencies (pytest, mypy, ruff)
# Cache mount persists uv cache across builds (5min → 30sec rebuild time)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

# Copy application code (changes most frequently - separate layer)
COPY main/ ./main/
COPY README.md ./

# Install project itself (now that application code is present)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# =============================================================================
# Stage 2: Runtime - Minimal production image
# =============================================================================
FROM python:3.12-slim-bookworm

WORKDIR /app

# Install runtime dependencies ONLY (no build tools)
# - libpq5: PostgreSQL client library (runtime for psycopg2)
# - tini: Init system for PID 1 (zombie reaping, signal forwarding)
# - ca-certificates: HTTPS connections to AWS APIs
# Note: No curl needed (workers don't have healthcheck endpoints)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5=15.* \
    tini=0.19.* \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security compliance before copying files
# UID 1000: Predictable across environments for ECS IAM role mapping
# -m: Create home directory
RUN useradd -m -u 1000 appuser && \
    chown appuser:appuser /app

# Copy virtual environment from builder stage
COPY --from=builder --chown=appuser:appuser /app/.venv /app/.venv

# Copy application code from builder stage
COPY --from=builder --chown=appuser:appuser /app/main /app/main
COPY --from=builder --chown=appuser:appuser /app/README.md /app/README.md

# Switch to non-root user (GAMP-5 security requirement)
USER appuser

# Configure Python environment
# PYTHONUNBUFFERED=1: Disable buffering for faster CloudWatch logs
# PYTHONDONTWRITEBYTECODE=1: Skip .pyc writing (read-only filesystem)
# PATH: Add virtual environment binaries to PATH
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

# No EXPOSE or HEALTHCHECK for workers (no HTTP endpoint)

# Tini as PID 1 for proper signal handling
# - Reaps zombie processes (prevents PID table exhaustion)
# - Forwards SIGTERM to application (graceful shutdown for ALCOA+ compliance)
# - Ensures in-flight jobs complete before termination
ENTRYPOINT ["/usr/bin/tini", "--"]

# Start background worker
# Worker runs as long-running coroutine processing jobs from queue
CMD ["python", "-m", "main.api.worker"]
